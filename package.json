{
  "name": "lanchonete-automation",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "lint": "eslint .",
    "format": "prettier . --write",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "evolution:up": "docker compose -f docker-compose.evolution.yml up -d",
    "evolution:down": "docker compose -f docker-compose.evolution.yml down",
    "evolution:logs": "docker compose -f docker-compose.evolution.yml logs -f evolution-api"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "effect": "^3.22.0",
    "eslint": "^9.0.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
